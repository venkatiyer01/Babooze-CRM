{
  "name": "ba-booze-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-ba-booze --only firestore 'vitest run --config vitest.rules.config.ts'",
    "test:e2e": "playwright test",
    "test:business": "node --test scripts/business-check.mjs",
    "test:e2e:emulators": "E2E_EMULATORS=true firebase emulators:exec --project demo-ba-booze --only auth,firestore 'playwright test workflows'",
    "test:static": "node scripts/static-check.mjs",
    "test:services": "node scripts/service-check.mjs",
    "verify:integration": "node scripts/verify-integration.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "firebase-tools": "^15.34.1",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  }
}
